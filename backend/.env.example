# Database
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Email
EMAIL_USERNAME=your_email@gmail.com
